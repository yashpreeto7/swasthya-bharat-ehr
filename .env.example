# MedIndia HealthOS — Environment Configuration Template

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change_this_to_a_secure_random_secret_in_production

# JWT Authentication
JWT_SECRET_KEY=supersecretjwtkey_replace_for_production_use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (PostgreSQL preferred, SQLite supported for quick local development)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medindia_healthos
# Fallback SQLite: sqlite+aiosqlite:///./.tmp/medindia_dev.db

# Vector Database (Qdrant) - Optional / Fallback to in-memory cosine similarity
QDRANT_HOST=localhost
QDRANT_PORT=6333

# AI & LLM Provider (Provider agnostic)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
PORT=3000
BACKEND_PORT=8000
