{
  "name": "swasthya-bharat-ehr",
  "version": "1.0.0",
  "description": "Swasthya Bharat EHR — ABDM-Compliant National Electronic Health Record Architecture",
  "private": true,
  "scripts": {
    "dev": "python execution/run_dev.py",
    "dev:frontend": "npm run dev --prefix frontend",
